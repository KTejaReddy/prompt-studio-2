# Groq API key for AI prompt generation (optional — only needed for the Generate feature)
GROQ_API_KEY=

# Turso cloud database (optional — falls back to local SQLite if unset)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Number of procedurally generated prompts to seed.
# Default: 220000 (local). Set to a lower number for Vercel serverless.
# PROMPTLY_GEN_TARGET=500

# Custom SQLite database path (optional — defaults to data/promptly.sqlite)
# PROMPTLY_DB=
